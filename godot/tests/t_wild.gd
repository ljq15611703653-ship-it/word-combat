	var ok := 0
	var bad: Array = []
	var weird := 0
	for c in cases:
		var toks: Array = T(c[2])
		var r := S.analyze(toks)
		var status := ""
		var text := ""
		if not r.complete:
			status = "✗ 拼不成句"
			bad.append(c[0])
		else:
			var sk: Dictionary = G.finalize(G.skill("x", r.skills[0]))
			var probs := G.problems(sk)
			text = str(sk.text)
			if probs.is_empty():
				status = "✓"
				ok += 1
				if H.good(r.skills[0]) == false:
					status = "✓(不太常见)"
			else:
				status = "△ 合法性：" + str(probs[0])
				bad.append(c[0])
		print("%s %s｜%s" % [status, c[0], c[1]])
		if text != "":
			print("      → ", text, "  （操作费 %d）" % int(G.finalize(G.skill("x", r.skills[0])).cost))
	print("共 %d 条，能拼成并合法 %d 条" % [cases.size(), ok])
	print("没通过的：", bad)
	quit()
