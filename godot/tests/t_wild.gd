extends SceneTree
# 天马行空测试：设想玩家可能想拼的各种句子，逐条看——能不能拼出来、合不合法、人话读起来对不对。
# 用法： -- （无参数）。每条：[名字, 想表达的意思, 牌（字符串=词，整数=数字，"~xxx"=连接牌）]
const G = preload("res://scripts/core/grammar.gd")
const S = preload("res://scripts/compose/sentence.gd")
const H = preload("res://scripts/compose/hints.gd")
const Lex = preload("res://scripts/core/lexicon.gd")

func T(a: Array) -> Array:
	return a.map(func(x):
		if x is int:
			return S.Num(x)
		if str(x).begins_with("~"):
			return S.Part(str(x).substr(1))
		return S.W(str(x)))

